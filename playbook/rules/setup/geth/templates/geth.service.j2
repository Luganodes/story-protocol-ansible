[Unit]
Description= Geth node for story protocol (EVM Layer)

[Service]
User={{ ansible_user }}
Group={{ ansible_user }}
ExecStart=/usr/local/bin/geth --story --syncmode full --metrics --metrics.addr 127.0.0.1 --metrics.expensive
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
